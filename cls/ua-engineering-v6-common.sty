% Logo entregado por la Facultad. La busqueda prioriza el directorio del .tex,
% lo que hace autocontenidos los paquetes semanales, y conserva alternativas
% para el paquete docente completo.
\newcommand{\UALogoPath}{logo_ingenieria_austral.png}
\newcommand{\UAResolvedLogo}{}
\newcommand{\UASetLogo}[1]{\renewcommand{\UALogoPath}{#1}\renewcommand{\UAResolvedLogo}{}}

\makeatletter
\newcommand{\UA@TryLogo}[1]{%
  \ifdefempty{\UAResolvedLogo}{%
    \IfFileExists{#1}{\renewcommand{\UAResolvedLogo}{#1}}{}%
  }{}%
}
\newcommand{\UAResolveLogo}{%
  \renewcommand{\UAResolvedLogo}{}%
  \UA@TryLogo{\UALogoPath}%
  \UA@TryLogo{assets/logo_ingenieria_austral.png}%
  \UA@TryLogo{../assets/logo_ingenieria_austral.png}%
  \UA@TryLogo{../../assets/logo_ingenieria_austral.png}%
  \UA@TryLogo{../../../assets/logo_ingenieria_austral.png}%
  \UA@TryLogo{../../../02_Fuentes_y_herramientas/assets/logo_ingenieria_austral.png}%
}
\newcommand{\UA@LogoFallback}{%
  \begingroup
  \setlength{\fboxsep}{0.28em}%
  \fcolorbox{UAIngOrange}{white}{%
    \scriptsize\bfseries\color{UAIngNavy}%
    UNIVERSIDAD AUSTRAL\hspace{0.45em}%
    {\color{UAIngOrange}|}\hspace{0.45em}INGENIERÍA}%
  \endgroup
}
\AtBeginDocument{\UAResolveLogo}

% Compatibilidad: UAPrintLogo recibe altura. UAPrintLogoWide recibe ancho.
\newcommand{\UAPrintLogo}[1][1.0cm]{%
  \ifdefempty{\UAResolvedLogo}{\UAResolveLogo}{}%
  \ifdefempty{\UAResolvedLogo}{\UA@LogoFallback}{%
    \includegraphics[height=#1,keepaspectratio]{\UAResolvedLogo}}%
}
\newcommand{\UAPrintLogoWide}[1][4.5cm]{%
  \ifdefempty{\UAResolvedLogo}{\UAResolveLogo}{}%
  \ifdefempty{\UAResolvedLogo}{\UA@LogoFallback}{%
    \includegraphics[width=#1,keepaspectratio]{\UAResolvedLogo}}%
}
\makeatother

